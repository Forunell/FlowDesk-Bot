# Generated automatically by setup.ps1. Never commit .env.
FLOWDESK_ADMIN_PASSWORD=
FLOWDESK_DB=data/flowdesk.sqlite3
# false is required for local HTTP. Public HTTPS must use true.
FLOWDESK_COOKIE_SECURE=false
# Optional second account. Distinct password, at least 12 characters.
FLOWDESK_OPERATOR_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Enable only after the designated administrator sends /verify_admin to the bot.
TELEGRAM_ADMIN_CONFIRMED=false
# Explicitly enable only when ready to send operator replies to actual clients.
# Both web server and polling process must be restarted after changing this.
TELEGRAM_REPLIES_ENABLED=false
